[sub_resource type="GDScript" id="GDScript_pbsdm"]
resource_name = "rts_camera"
script/source = "extends Camera2D

var directions := {
	\"Top\" = [Vector2(0, -1), false],
	\"Bottom\" = [Vector2(0, 1), false],
	\"Left\" = [Vector2(-1, 0), false],
	\"Right\" = [Vector2(1, 0), false],
}

const speed := 15.0

# Called when the node enters the scene tree for the first time.
func _ready() -> void:
	for area in get_children():
		if area is Area2D:
			area.mouse_entered.connect(_on_area_mouse_entered.bind(area))
			area.mouse_exited.connect(_on_area_mouse_exited.bind(area))

func _on_area_mouse_entered(area: Area2D):
	directions[String(area.name)][1] = true
	
func _on_area_mouse_exited(area: Area2D):
	directions[String(area.name)][1] = false

# Called every frame. 'delta' is the elapsed time since the previous frame.
func _process(delta: float) -> void:
	for dir in directions:
		var path := NodePath(dir)
		var area: Area2D = get_node(path)
		var angle: Vector2 = directions[dir][0]
		
		if directions[dir][1]:
			var cs := (area.get_node(\"CollisionShape2D\") as CollisionShape2D)
			var cs_size: Vector2 = cs.shape.size/2
			var p1 := cs.position
			var p2 := get_local_mouse_position()
			print((p2.x), cs_size.x, cs_size.y)
			var unit_max_x = sign(p1) * ((p2.x) / abs(cs_size.x))
			print(unit_max_x)
			position += angle * speed * delta
"

