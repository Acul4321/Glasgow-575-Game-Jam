[sub_resource type="TileSet" id="TileSet_pbsdm"]
sources/3 = SubResource("TileSetAtlasSource_rwgxs")

[sub_resource type="GDScript" id="GDScript_l56o8"]
resource_name = "camerascript"
script/source = "extends Camera2D

@onready var area2d: Area2D = $Area2D
@onready var water: ColorRect = get_parent().get_node(\"Water\")
var child_positions: Dictionary = {}

# Called when the node enters the scene tree for the first time.
func _ready() -> void:
	for child in get_children():
		if child is Node2D or child is Control:
			child_positions[child] = child.position

func _process(_delta: float) -> void:
	# so UI moves with camera, all UI follows smooth camera movement
	var smoothing_offset := get_screen_center_position() - global_position

	for child in child_positions:
		child.position = child_positions[child] + smoothing_offset

func _input(event: InputEvent) -> void:
	if event is InputEventMouseButton:
		if event.button_index == MOUSE_BUTTON_WHEEL_UP and event.pressed:
			position.y -= 20
		elif event.button_index == MOUSE_BUTTON_WHEEL_DOWN and event.pressed:
			position.y += 20
			
		var viewport_size: Vector2 = get_viewport().get_visible_rect().size
		var visible_camera_size: Vector2 = viewport_size / zoom
		var water_up: float = water.position.y
		var water_bottom: float = water.position.y + water.size.y
		var camera_half_height: float = visible_camera_size.y / 2.0
		
		if position.y - camera_half_height <= water_up:
			position.y = water_up + camera_half_height
		elif position.y + camera_half_height >= water_bottom:
			position.y = water_bottom - camera_half_height
"

